generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id           String   @id @default(cuid())
  ticketCode   String   @unique
  fullName     String
  email        String
  laptopNumber  String?
  desktopNumber String?
  siteName      String
  issueType    String
  customIssue  String?
  priority     Priority @default(MEDIUM)
  attachment   String?
  status       Status   @default(PENDING)
  remark       String?
  internalNote String?
  assignedTo   String?
  assignedUser User?    @relation(fields: [assignedTo], references: [id])
  contactNumber String?
  slaEmailSent Boolean  @default(false)
  reads        TicketRead[]
  activities   TicketActivity[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  password        String
  role            Role     @default(ADMIN)
  active          Boolean  @default(true)
  assignedTickets Ticket[]
  ticketReads     TicketRead[]
  ticketActivities TicketActivity[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TicketRead {
  id       String   @id @default(cuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminId  String
  admin    User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([ticketId, adminId])
  @@index([adminId])
}

// Audit trail — one row per meaningful change to a ticket (status change, assignment, or generic update)
model TicketActivity {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorName String   // denormalized snapshot — keeps the log readable even if the admin account is later deleted/deactivated
  action    String   // 'STATUS_CHANGE' | 'ASSIGNED' | 'UPDATED'
  detail    String   // human-readable description, e.g. "Status changed from PENDING to RESOLVED"
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Laptop {
  id           String   @id @default(cuid())
  assetCode    String   @unique
  assignedTo   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Desktop {
  id           String   @id @default(cuid())
  assetCode    String   @unique
  assignedTo   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum Status {
  PENDING
  UNRESOLVED
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
